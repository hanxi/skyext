.role {
    _version 0 : integer
    rid 1 : integer
    name 2 : string
    account 3 : string
    server 4 : string # 出生服，终身不变。所属 game / zone 用 skyext.realm 现查，合服不改这里
    create_time 6 : integer
    last_login_time 7 : integer
    modules 8 : role_modules # 模块列表
}

.role_modules {
    bag 0 : role_bag # 资源列表
    mail 1 : role_mail # 邮件列表
}

