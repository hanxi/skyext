.role {
    _version 0 : integer
    rid 1 : integer
    name 2 : string
    account 3 : string
    server 4 : string # 客户端看到的服务器
    game 5 : string # 框定玩法范围的游戏服务器:合服就是把game改成相同的
    create_time 6 : integer
    last_login_time 7 : integer
    modules 8 : role_modules # 模块列表
}

.role_modules {
    bag 0 : role_bag # 资源列表
    mail 1 : role_mail # 邮件列表
}

