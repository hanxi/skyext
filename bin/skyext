#!/bin/bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

_TMP_CONF=""
trap '[[ -n "$_TMP_CONF" ]] && rm -f "$_TMP_CONF"' EXIT

# ── 颜色 ─────────────────────────────────────────────
RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; BOLD=$'\033[1m'; NC=$'\033[0m'

# ── help ──────────────────────────────────────────────
usage() {
    cat <<EOF
${BOLD}skyext${NC} — skyext 游戏服务器框架 CLI

${BOLD}用法:${NC}
  skyext <command> [options]

${BOLD}命令:${NC}
  test    运行测试
  serve   启动服务节点

${BOLD}示例:${NC}
  skyext test                          运行所有测试
  skyext test --cov                    运行测试并收集覆盖率
  skyext test lualib/skyext/           运行指定目录下的测试
  skyext serve account1                启动 account1 节点
  skyext serve example/etc/role1.conf.lua  使用完整配置路径启动

运行 ${BOLD}skyext <command> --help${NC} 查看子命令帮助。
EOF
}

# ══════════════════════════════════════════════════════
# skyext test
# ══════════════════════════════════════════════════════
cmd_test() {
    local timeout="${SKYTEST_TIMEOUT:-120}"
    local match=""
    local cov=""
    local conf=""
    local targets=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout) timeout="$2"; shift 2 ;;
            --match)   match="$2"; shift 2 ;;
            --cov)     cov=1; shift ;;
            --conf)    conf="$2"; shift 2 ;;
            -h|--help)
                cat <<EOF
${BOLD}skyext test${NC} — 运行测试

${BOLD}用法:${NC}
  skyext test [options] [target...]

${BOLD}选项:${NC}
  --match PATTERN   按路径子串过滤测试文件
  --cov             启用覆盖率收集
  --timeout SECS    单文件超时秒数 (默认: 120)
  --conf FILE       自定义 skynet 配置 (极少需要)

${BOLD}目标:${NC}
  文件或目录，默认扫描 lualib/ service/ example/ test/
EOF
                return 0 ;;
            *) targets+=("$1"); shift ;;
        esac
    done

    # 默认扫描目录
    if [[ ${#targets[@]} -eq 0 ]]; then
        targets=("lualib/" "service/" "example/" "test/")
    fi

    # 发现测试文件
    local files=()
    for target in "${targets[@]}"; do
        if [[ -f "$target" ]]; then
            files+=("$target")
        elif [[ -d "$target" ]]; then
            while IFS= read -r f; do
                files+=("$f")
            done < <(find "$target" -name "*.test.lua" -type f 2>/dev/null | sort)
        fi
    done

    # 路径过滤
    if [[ -n "$match" ]]; then
        local filtered=()
        for f in "${files[@]}"; do
            [[ "$f" == *"$match"* ]] && filtered+=("$f")
        done
        files=("${filtered[@]}")
    fi

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "No test files found."
        return 0
    fi

    # 生成临时配置
    if [[ -z "$conf" ]]; then
        _TMP_CONF=$(mktemp /tmp/skytest_XXXXXX.conf.lua)
        conf="$_TMP_CONF"
        cat > "$conf" << CONF_EOF
root = "$ROOT/"
skyext_root = root
game_root = root .. "example/"
start = "skytest_runner"
app_config_loaded = "true"
include "$ROOT/example/etc/paths.conf.lua"
thread = 4
harbor = 0
bootstrap = "snlua bootstrap"
logservice = "snlua"
logger = "logger"
CONF_EOF
    fi



    # 覆盖率设置
    local cov_dir="${SKYTEST_COV_OUTPUT_DIR:-./coverage}"
    if [[ -n "$cov" ]]; then
        export SKYTEST_COV=1
        export SKYTEST_COV_OUTPUT_DIR="$cov_dir"
        export SKYTEST_COV_SOURCE_DIRS="${SKYTEST_COV_SOURCE_DIRS:-lualib/,example/lualib/}"
        export SKYTEST_COV_EXCLUDE="${SKYTEST_COV_EXCLUDE:-skynet/,.test.lua}"
        mkdir -p "$cov_dir"
    fi

    # 检测 timeout 命令
    local TIMEOUT_CMD=""
    if command -v timeout &>/dev/null; then
        TIMEOUT_CMD="timeout"
    elif command -v gtimeout &>/dev/null; then
        TIMEOUT_CMD="gtimeout"
    fi

    # 运行测试
    local total=0 passed=0 failed=0 errors=0
    local failed_files=()

    for file in "${files[@]}"; do
        total=$((total + 1))
        echo -e "${BOLD}▶${NC} $file"

        if [[ -n "$TIMEOUT_CMD" ]]; then
            local run_cmd=("$TIMEOUT_CMD" --kill-after=5 "$timeout" env SKYTEST_FILE="$file" ./bin/skynet "$conf")
        else
            local run_cmd=(env SKYTEST_FILE="$file" ./bin/skynet "$conf")
        fi
        if "${run_cmd[@]}" 2>&1; then
            passed=$((passed + 1))
        else
            local exit_code=$?
            if [[ $exit_code -eq 124 ]]; then
                echo -e "  ${RED}TIMEOUT${NC} after ${timeout}s"
                failed=$((failed + 1))
            elif [[ $exit_code -eq 2 ]]; then
                errors=$((errors + 1))
            else
                failed=$((failed + 1))
            fi
            failed_files+=("$file")
        fi
        echo ""
    done

    # 合并覆盖率 & 生成报告
    if [[ -n "$cov" ]] && [[ -d "$cov_dir" ]]; then
        local info_files=()
        while IFS= read -r f; do
            info_files+=("$f")
        done < <(find "$cov_dir" -name "*.info" -type f 2>/dev/null)

        if [[ ${#info_files[@]} -gt 1 ]]; then
            "$ROOT/scripts/cov/merge.sh" -o "$cov_dir/lua_coverage.info" "${info_files[@]}"
        fi

        local lcov_file="$cov_dir/lua_coverage.info"
        if [[ -f "$lcov_file" ]]; then
            # 过滤非项目源文件
            awk '
                /^SF:/ {
                    skip=0
                    if ($0 !~ /^SF:\.\//) skip=1
                    if ($0 ~ /^SF:\.\/example\/etc\//) skip=1
                    if ($0 ~ /^SF:\.\/example\/hotfix\//) skip=1
                    if ($0 ~ /^SF:\.\/example\/tools\//) skip=1
                    if ($0 ~ /^SF:\.\/example\/res\//) skip=1
                }
                !skip { print }
            ' "$lcov_file" > "$cov_dir/lua_coverage_clean.info"

            # 生成 HTML 报告
            if command -v genhtml >/dev/null 2>&1; then
                local html_dir="$cov_dir/html"
                rm -rf "$html_dir"
                genhtml "$cov_dir/lua_coverage_clean.info" \
                    --output-directory "$html_dir" \
                    --title "skyext coverage" \
                    --legend \
                    --no-function-coverage \
                    2>&1 | tail -5
            fi

            # 覆盖率摘要
            local cov_files cov_total cov_covered cov_pct
            cov_files=$(grep -c "^SF:" "$cov_dir/lua_coverage_clean.info" || echo 0)
            cov_total=$(awk '/^DA:/{n++} END{print n+0}' "$cov_dir/lua_coverage_clean.info")
            cov_covered=$(awk '/^DA:/{split($0,a,","); if(a[2]+0>0) n++} END{print n+0}' "$cov_dir/lua_coverage_clean.info")
            if [[ "$cov_total" -gt 0 ]]; then
                cov_pct=$(awk "BEGIN{printf \"%.1f\", $cov_covered*100/$cov_total}")
            else
                cov_pct="0.0"
            fi

            echo ""
            echo -e "${BOLD}覆盖率: ${cov_pct}%${NC} ($cov_covered/$cov_total 行, $cov_files 文件)"
            echo -e "  lcov:  $cov_dir/lua_coverage_clean.info"
            [[ -d "$cov_dir/html" ]] && echo -e "  报告:  $cov_dir/html/index.html"
        fi
    fi

    # 测试汇总
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    if [[ $failed -eq 0 ]] && [[ $errors -eq 0 ]]; then
        echo -e "${GREEN}$total files, $passed passed${NC}"
    else
        echo -e "${RED}$total files, $passed passed, $failed failed, $errors errors${NC}"
        echo ""
        echo "Failed:"
        for f in "${failed_files[@]}"; do
            echo "  $f"
        done
    fi
    echo ""

    [[ $failed -eq 0 ]] && [[ $errors -eq 0 ]]
}

# ══════════════════════════════════════════════════════
# skyext serve
# ══════════════════════════════════════════════════════
cmd_serve() {
    if [[ $# -eq 0 ]] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
        cat <<EOF
${BOLD}skyext serve${NC} — 启动服务节点

${BOLD}用法:${NC}
  skyext serve <node>
  skyext serve <conf_file>

${BOLD}示例:${NC}
  skyext serve account1                启动 account1 节点
  skyext serve role1                   启动 role1 节点
  skyext serve example/etc/role2.conf.lua  使用完整配置文件

${BOLD}可用节点:${NC}
EOF
        for f in example/etc/*.conf.lua; do
            [[ -f "$f" ]] || continue
            local name
            name=$(basename "$f" .conf.lua)
            [[ "$name" == "core" || "$name" == "paths" ]] && continue
            echo "  $name"
        done
        return 0
    fi

    local target="$1"
    shift

    # 如果是完整路径且文件存在，直接用
    if [[ -f "$target" ]]; then
        exec ./bin/skynet "$target" "$@"
    fi

    # 否则当作节点名查找
    local conf_file="example/etc/${target}.conf.lua"
    if [[ ! -f "$conf_file" ]]; then
        echo -e "${RED}错误:${NC} 找不到配置文件: $conf_file" >&2
        echo "运行 skyext serve --help 查看可用节点" >&2
        return 1
    fi

    exec ./bin/skynet "$conf_file" "$@"
}

# ══════════════════════════════════════════════════════
# 入口
# ══════════════════════════════════════════════════════
case "${1:-}" in
    test)   shift; cmd_test "$@" ;;
    serve)  shift; cmd_serve "$@" ;;
    -h|--help|"") usage ;;
    *)
        echo -e "${RED}未知命令:${NC} $1" >&2
        echo "运行 skyext --help 查看帮助" >&2
        exit 1 ;;
esac
