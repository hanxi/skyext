#!/bin/sh

case "$0" in
    */*) script=$0 ;;
    *) script=$(command -v "$0") || exit 1 ;;
esac
case "$script" in
    */*) bin_dir=${script%/*}; [ -n "$bin_dir" ] || bin_dir=/ ;;
    *) bin_dir=. ;;
esac
bin_dir=$(CDPATH= cd "$bin_dir" && pwd -P) || exit 1
lua="$bin_dir/lua"
[ -f "$lua" ] || lua="$bin_dir/lua.exe"
exec "$lua" "$bin_dir/../scripts/skyext.lua" "$@"
